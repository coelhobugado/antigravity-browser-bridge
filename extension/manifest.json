{
  "manifest_version": 3,
  "key": "",
  "name": "Antigravity Agent Connector",
  "version": "1.1.2",
  "description": "Permite ao Antigravity agent operar o navegador nativamente com as contas ativas do usuário.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Autorizar esta aba para o Antigravity",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
